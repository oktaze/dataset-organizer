# Copy to .env for the standalone `uvicorn` debug command.
# In the Tauri app these are passed to the sidecar process by the Rust spawner.

# WD Tagger model repo suffix under SmilingWolf/ (e.g. wd-swinv2-tagger-v3).
WD_MODEL=wd-vit-tagger-v3

# Minimum confidence score for a tag to be returned.
WD_THRESHOLD=0.35
