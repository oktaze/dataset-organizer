{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dataset Organizer",
  "version": "0.3.0",
  "identifier": "com.oktaze.dataset-organizer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dataset Organizer",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwNkIyRjk0QjQ0QTQ2RjgKUldUNFJrcTBsQzlyY0lvNVVWNnRhZXpyYjJIcVJ1MFh2RkR4RkRyWkl2ZkxsSTJNcUlmUWVnaGMK",
      "endpoints": [
        "https://github.com/oktaze/dataset-organizer/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "dmg", "app", "nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["sidecar-bin/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
